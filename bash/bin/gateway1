#!/bin/bash
#Generated by JetBrains Toolbox 2.5.4.38621 at 2025-02-28T02:55:43

declare -a intellij_args=()
declare -- wait=""

for o in "$@"; do
  if [[ "$o" = "--wait" || "$o" = "-w" ]]; then
    wait="-W"
    o="--wait"
  fi
  if [[ "$o" =~ " " ]]; then
    intellij_args+=("\"$o\"")
  else
    intellij_args+=("$o")
  fi
done

open -na "/Applications/JetBrains Gateway 2024.3.1.1.app/Contents/MacOS/gateway" $wait --args "${intellij_args[@]}"