#!/usr/bin/env bash

set -euo pipefail

if [[ "$OSTYPE" != "darwin"* ]]; then
  echo "SketchyBar is only supported on macOS" >&2
  exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required to start SketchyBar" >&2
  exit 1
fi

# Restart so a restow also reloads the current configuration.
brew services restart felixkratz/formulae/sketchybar
