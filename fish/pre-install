#!/usr/bin/env bash

set -euo pipefail

mkdir -p "$HOME/.config/fish/functions"
mkdir -p "$HOME/.config/fish/conf.d"
mkdir -p "$HOME/.config/fish/completions"

if [[ "$OSTYPE" == "darwin"* ]]; then
  if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew is required to install Fish dependencies on macOS" >&2
    exit 1
  fi

  # Keep Fish first: the remaining formulas are dependencies of its config.
  for formula in fish fd ghq fzf coreutils fnm; do
    if ! brew list --formula "$formula" >/dev/null 2>&1; then
      brew install "$formula"
    fi
  done

  if ! brew list --cask git-credential-manager >/dev/null 2>&1; then
    brew install --cask git-credential-manager
  fi

  GCM_PATH="/usr/local/share/gcm-core/git-credential-manager"
  if [[ ! -x "$GCM_PATH" ]]; then
    echo "Git Credential Manager is not executable at $GCM_PATH" >&2
    exit 1
  fi

  if [[ -x /opt/homebrew/bin/git ]]; then
    NATIVE_GIT_PATH=/opt/homebrew/bin/git
  elif [[ -x /usr/bin/git ]]; then
    NATIVE_GIT_PATH=/usr/bin/git
  else
    echo "Native Git is required to configure Git Credential Manager" >&2
    exit 1
  fi

  if ! "$NATIVE_GIT_PATH" config --global --get-all credential.helper | grep -Fqx -- "$GCM_PATH"; then
    env -u GIT_USER_AGENT -u GIT_HTTP_USER_AGENT \
      PATH="${NATIVE_GIT_PATH%/*}:$PATH" \
      "$GCM_PATH" configure
  fi

  if ! "$NATIVE_GIT_PATH" config --global --get-all credential.helper | grep -Fqx -- "$GCM_PATH"; then
    echo "Git Credential Manager is not configured as a global credential helper" >&2
    exit 1
  fi

  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import curses, sys; raise SystemExit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    brew install python
    hash -r
  fi

  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import curses, sys; raise SystemExit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    echo "Python 3.8 or newer with curses is required for the clickable shortcut guide" >&2
    exit 1
  fi
else
  missing_dependencies=()
  command -v fd >/dev/null 2>&1 || missing_dependencies+=(fd)
  command -v ghq >/dev/null 2>&1 || missing_dependencies+=(ghq)
  command -v fzf >/dev/null 2>&1 || missing_dependencies+=(fzf)
  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import curses, sys; raise SystemExit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    missing_dependencies+=(python)
  fi

  if ((${#missing_dependencies[@]} > 0)); then
    printf 'Please install these packages through your system package manager: %s\n' "${missing_dependencies[*]}" >&2
    exit 1
  fi
fi

CURRENT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_SOURCE="$CURRENT_DIR/fish_plugins"
PLUGIN_TARGET="$HOME/.config/fish/fish_plugins"

if [[ -L "$PLUGIN_TARGET" ]]; then
  if [[ ! "$PLUGIN_TARGET" -ef "$PLUGIN_SOURCE" ]]; then
    echo "Refusing to replace existing symlink: $PLUGIN_TARGET" >&2
    exit 1
  fi
elif [[ -e "$PLUGIN_TARGET" ]]; then
  echo "Refusing to replace existing file: $PLUGIN_TARGET" >&2
  exit 1
else
  ln -s "$PLUGIN_SOURCE" "$PLUGIN_TARGET"
fi
