#!/usr/bin/env bash

set -euo pipefail

if ! command -v fish >/dev/null 2>&1; then
  echo "fish is required to install Fisher plugins" >&2
  exit 1
fi
FISH_PATH="$(command -v fish)"

if [[ "$EUID" -eq 0 ]]; then
  echo "Run ./install.sh fish as your normal user, not with sudo" >&2
  exit 1
fi

if [[ "$FISH_PATH" != /* || ! -x "$FISH_PATH" ]]; then
  echo "Fish must resolve to an absolute executable path: $FISH_PATH" >&2
  exit 1
fi

current_login_shell() {
  local user="$1"

  if [[ "$OSTYPE" == "darwin"* ]] && command -v dscl >/dev/null 2>&1; then
    dscl . -read "/Users/$user" UserShell 2>/dev/null | awk 'NR == 1 {print $2}'
  elif [[ "$OSTYPE" == "linux"* ]] && command -v getent >/dev/null 2>&1; then
    getent passwd "$user" | awk -F: 'NR == 1 {print $7}'
  else
    return 1
  fi
}

sync_macos_gui_shell() {
  if [[ "$OSTYPE" != "darwin"* ]]; then
    return 0
  fi

  if ! command -v launchctl >/dev/null 2>&1; then
    echo "launchctl is required to update the macOS GUI shell environment" >&2
    return 1
  fi

  local launchctl_path user_id gui_shell
  launchctl_path="$(command -v launchctl)"
  if [[ "$launchctl_path" != /* || ! -x "$launchctl_path" ]]; then
    echo "launchctl must resolve to an absolute executable path: $launchctl_path" >&2
    return 1
  fi
  user_id="$(id -u)"

  if ! "$launchctl_path" print "gui/$user_id" >/dev/null 2>&1; then
    echo "No active macOS GUI session; skipping GUI shell environment update"
    return 0
  fi

  gui_shell="$("$launchctl_path" asuser "$user_id" "$launchctl_path" getenv SHELL 2>/dev/null || true)"
  if [[ "$gui_shell" == "$FISH_PATH" ]]; then
    echo "New macOS apps already inherit Fish as SHELL"
    return 0
  fi

  echo "Setting Fish as SHELL for newly launched macOS apps"
  if ! "$launchctl_path" asuser "$user_id" "$launchctl_path" setenv SHELL "$FISH_PATH"; then
    echo "Failed to update SHELL in the macOS GUI launch environment" >&2
    return 1
  fi

  gui_shell="$("$launchctl_path" asuser "$user_id" "$launchctl_path" getenv SHELL 2>/dev/null || true)"
  if [[ "$gui_shell" != "$FISH_PATH" ]]; then
    echo "Failed to verify SHELL in the macOS GUI launch environment" >&2
    return 1
  fi
}

CURRENT_USER="$(id -un)"
if ! LOGIN_SHELL="$(current_login_shell "$CURRENT_USER")" || [[ "$LOGIN_SHELL" != /* ]]; then
  echo "Unable to determine the login shell for $CURRENT_USER" >&2
  exit 1
fi

SHELL_CHANGE_NEEDED=0
if [[ "$LOGIN_SHELL" != "$FISH_PATH" ]]; then
  SHELL_CHANGE_NEEDED=1

  if ! command -v chsh >/dev/null 2>&1; then
    echo "chsh is required to make Fish the default shell" >&2
    exit 1
  fi
  CHSH_PATH="$(command -v chsh)"
  if [[ "$CHSH_PATH" != /* || ! -x "$CHSH_PATH" ]]; then
    echo "chsh must resolve to an absolute executable path: $CHSH_PATH" >&2
    exit 1
  fi

  if [[ ! -t 0 ]]; then
    if ! command -v sudo >/dev/null 2>&1 || ! sudo -n true >/dev/null 2>&1; then
      echo "Changing the default shell requires an interactive terminal." >&2
      echo "Re-run ./install.sh fish interactively or run: chsh -s $FISH_PATH" >&2
      exit 1
    fi
  elif ! grep -Fqx -- "$FISH_PATH" /etc/shells && [[ ! -w /etc/shells ]] && ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to register Fish as a login shell" >&2
    exit 1
  fi
fi

"$FISH_PATH" -c '
if not type -q fisher
    if not type -q curl
        echo "curl is required to install Fisher" >&2
        exit 1
    end
    curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
end
fisher update
'

BINDINGS_HELPER="$HOME/.config/fish/functions/_phonglk_auto_complete_help.fish"
INVALID_BIND_PATTERN='^[[:space:]]*bind --erase --preset( -M (insert|visual))? \\cx fish_clipboard_copy$'
if [[ -f "$BINDINGS_HELPER" ]] && grep -Eq "$INVALID_BIND_PATTERN" "$BINDINGS_HELPER"; then
  echo "Repairing invalid Ctrl-X erase bindings for Fish 4"
  if ! LC_ALL=C sed -E -i.bak \
    '/^[[:space:]]*bind --erase --preset( -M (insert|visual))? \\cx fish_clipboard_copy$/s/ fish_clipboard_copy$//' \
    "$BINDINGS_HELPER"; then
    [[ ! -f "$BINDINGS_HELPER.bak" ]] || mv -f -- "$BINDINGS_HELPER.bak" "$BINDINGS_HELPER"
    echo "Failed to repair invalid Ctrl-X erase bindings in $BINDINGS_HELPER" >&2
    exit 1
  fi

  if grep -Eq "$INVALID_BIND_PATTERN" "$BINDINGS_HELPER"; then
    mv -f -- "$BINDINGS_HELPER.bak" "$BINDINGS_HELPER"
    echo "Failed to verify repaired Ctrl-X erase bindings in $BINDINGS_HELPER" >&2
    exit 1
  fi

  rm -f -- "$BINDINGS_HELPER.bak"
fi

if [[ "$SHELL_CHANGE_NEEDED" -eq 0 ]]; then
  sync_macos_gui_shell
  echo "Fish is already the default shell for $CURRENT_USER"
  exit 0
fi

if ! grep -Fqx -- "$FISH_PATH" /etc/shells; then
  echo "Registering $FISH_PATH in /etc/shells"
  if [[ -w /etc/shells ]]; then
    printf '%s\n' "$FISH_PATH" >> /etc/shells
  else
    if [[ -t 0 ]]; then
      if ! printf '%s\n' "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null; then
        echo "Failed to register $FISH_PATH in /etc/shells" >&2
        exit 1
      fi
    else
      if ! printf '%s\n' "$FISH_PATH" | sudo -n tee -a /etc/shells >/dev/null; then
        echo "Failed to register $FISH_PATH in /etc/shells with sudo" >&2
        exit 1
      fi
    fi
  fi

  if ! grep -Fqx -- "$FISH_PATH" /etc/shells; then
    echo "Failed to register $FISH_PATH in /etc/shells" >&2
    exit 1
  fi
fi

echo "Setting $FISH_PATH as the default shell for $CURRENT_USER"
if [[ -t 0 ]]; then
  if ! "$CHSH_PATH" -s "$FISH_PATH"; then
    echo "Failed to change the default shell for $CURRENT_USER" >&2
    exit 1
  fi
else
  if ! sudo -n "$CHSH_PATH" -s "$FISH_PATH" "$CURRENT_USER"; then
    echo "Failed to change the default shell for $CURRENT_USER with sudo" >&2
    exit 1
  fi
fi

if ! LOGIN_SHELL="$(current_login_shell "$CURRENT_USER")" || [[ "$LOGIN_SHELL" != "$FISH_PATH" ]]; then
  echo "Failed to set Fish as the default shell for $CURRENT_USER" >&2
  exit 1
fi

sync_macos_gui_shell
echo "Fish will be used for new login sessions."
